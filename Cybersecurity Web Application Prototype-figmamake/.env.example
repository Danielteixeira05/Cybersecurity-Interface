# Configuracao do frontend React/Vite (Cybersecurity-Interface).
# Opcionalmente define explicitamente o URL do backend Django.
# Em producao no Vercel usa rewrites no vercel.json (não precisas disto).

# ===== Modo DESENVOLVIMENTO LOCAL =====
# O Vite ja faz proxy para 127.0.0.1:8000 por padrao.
# Altera apenas se o Django correr noutra porta.
# VITE_DJANGO_URL=http://127.0.0.1:8000
# VITE_DJANGO_PORT=8000

# ===== Modo PRODUCAO (Vercel) =====
# URL BASE do BACKEND (Django) publicado no Vercel (ou outro dominio).
# Exemplo: VITE_API_BASE_URL=https://cybersecurity-abc123.vercel.app
# Em alternativa coloca "" para usar o mesmo dominio (com rewrites no vercel.json).
# VITE_API_BASE_URL=
