# URL pública do backend ativo. Em desenvolvimento, deixe vazia para usar /api via proxy Vite.
VITE_API_URL=

# Destino do proxy local do Vite quando VITE_API_URL estiver vazia.
VITE_API_PROXY_TARGET=http://localhost:3001
# Origem do backend Socket.IO, sem o sufixo /api. O path é fixo: /api/socket-io/socket.io.
VITE_SOCKET_URL=
