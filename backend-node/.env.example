# Apenas valores de desenvolvimento/teste. Nunca versionar o ficheiro .env real.
# Em produção, DATABASE_URL deve ser a URL do pooler Neon; o backend exige TLS verify-full.
PORT=3001
DATABASE_URL=
JWT_SECRET=
READ_ONLY_MODE=false
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:8443
# Origens explícitas autorizadas a abrir WebSocket. Separe múltiplas origens por vírgula.
SOCKET_CORS_ORIGINS=http://localhost:8443
# O Socket.IO usa sempre /api/socket-io/socket.io. VITE_SOCKET_URL aponta só para a origem do backend.

# Limite funcional de um upload documental. O teto de segurança nunca pode ser ultrapassado.
MAX_UPLOAD_MB=10
DOCUMENT_UPLOAD_SAFETY_MAX_MB=50

# Necessário apenas quando um Vercel Blob privado estiver ligado ao backend Node.
# Sem este valor, operações reais de ficheiros devolvem 503 controlado.
BLOB_READ_WRITE_TOKEN=
